# Endurecimiento básico (Apache). Requiere AllowOverride All en el DocumentRoot.

Options -Indexes

# Nunca servir archivos ocultos ni de configuración/respaldo
<FilesMatch "^\.(?!well-known)|\.(env|sql|log|bak|old|orig|dist|md|lock|ini|sh)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>
