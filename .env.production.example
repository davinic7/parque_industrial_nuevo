# =============================================================================
# Plantilla del .env para PRODUCCIÓN — Portal Parque Industrial de Catamarca
#
# Copiar como `.env` en el servidor y completar TODOS los valores marcados con
# CAMBIAR. Nunca subir el `.env` real a git (ya está en .gitignore).
# Permisos recomendados: chmod 640 .env
# =============================================================================

# --- Entorno -----------------------------------------------------------------
APP_ENV=production
APP_DEBUG=0

# URL pública del sitio que apunta a la carpeta public/ (raíz web), con https y SIN barra final.
SITE_URL=https://CAMBIAR-dominio-del-parque.gob.ar

# --- Sesión y HTTPS ----------------------------------------------------------
# Solo poner en 1 cuando el sitio ya se sirve por HTTPS.
SESSION_COOKIE_SECURE=1
# 1 = redirige HTTP a HTTPS (respeta X-Forwarded-Proto detrás de un proxy).
FORCE_HTTPS=1

# --- Base de datos -----------------------------------------------------------
# Usar el usuario de permisos mínimos (database/crear_usuario_app.sql), NUNCA root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=parque_industrial
DB_USER=parque_app
DB_PASS=CAMBIAR-contrasena-larga-y-aleatoria
DB_CHARSET=utf8mb4
# Base gestionada con SSL (Aiven, etc.): ruta al certificado, p. ej. config/ca.pem. Vacío si no aplica.
DB_SSL_CA=

# --- Archivos subidos (Cloudinary) -------------------------------------------
# OBLIGATORIO en hosting con disco efímero (Render, etc.): sin esto, los archivos
# subidos se pierden en cada despliegue. En un servidor propio con backups se pueden dejar vacías.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Tareas programadas (cron) -----------------------------------------------
# Clave larga y aleatoria. Se pasa como ?key= a los scripts de public/ministerio/cron/.
# Sin ella, esos scripts solo se pueden ejecutar por línea de comandos.
CRON_SECRET=CAMBIAR-clave-larga-y-aleatoria

# Días que se conserva el historial antes de que lo purgue el cron limpiar-historial.php (mínimo 30).
# LOG_RETENCION_DIAS=365
# VISITAS_RETENCION_DIAS=180

# --- Correo ------------------------------------------------------------------
# Resend (resend.com): verificar el dominio y generar la API key.
RESEND_API_KEY=
MAIL_FROM=no-reply@CAMBIAR-dominio-del-parque.gob.ar

# --- reCAPTCHA v2 (OBLIGATORIO en producción) --------------------------------
# https://www.google.com/recaptcha/admin  (agregar el dominio del sitio).
# Sin estas claves, el login, la recuperación de contraseña y "Presentar proyecto" quedan abiertos a spam.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
